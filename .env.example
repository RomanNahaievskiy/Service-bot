# ===============================
# TELEGRAM
# ===============================
BOT_TOKEN=your_telegram_bot_token

# ===============================
# APP
# ===============================
NODE_ENV=development
# Business timezone for booking dates, slots, reminders and Sheets timestamps.
BUSINESS_TIME_ZONE=Europe/Kyiv
# Legacy alias supported by the app; keep it equal to BUSINESS_TIME_ZONE if used.
APP_TIMEZONE=Europe/Kyiv

# ===============================
# GOOGLE SCRIPT URL / SHEETS API
# ===============================
SHEETS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec?mode=api
SHEETS_API_TOKEN=your_sheets_api_token


# ===============================
# BUSINESS SETTINGS
# ===============================
WORKDAY_START=08:00
WORKDAY_END=22:00
SLOT_STEP_MINUTES=15
BREAKS=[{"start":"13:15","end":"14:00"}]


# ===============================
# NOTIFICATIONS
# ===============================
REMINDER_ENABLED=true
REMINDER_BEFORE_HOURS=24
REMINDER_BEFORE_MINUTES=0

SECOND_REMINDER_ENABLED=true
SECOND_REMINDER_BEFORE_HOURS=2

# ===============================
# CONTACTS
# ===============================
OPERATOR_PHONE=+380000000000


